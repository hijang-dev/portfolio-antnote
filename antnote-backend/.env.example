# Application
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3001

# PostgreSQL
# Host port is 5433 (not 5432) to avoid clashing with a locally installed
# Postgres instance. The container listens on 5432 internally either way.
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=antnote
DB_PASSWORD=antnote
DB_NAME=antnote
